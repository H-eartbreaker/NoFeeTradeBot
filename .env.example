# Telegram: 在 @BotFather 创建机器人拿到 token
TELEGRAM_BOT_TOKEN=
# 只有这个 Telegram 用户 ID 能操作机器人（用 @userinfobot 查你的数字 ID）
ALLOWED_USER_ID=
# 专用热钱包私钥（0x 开头 64 位十六进制）。只放小额资金，绝不要用主钱包
PRIVATE_KEY=

# 链，目前支持: bsc
# 启用的链，逗号分隔: bsc, base, eth, rh（Robinhood Chain）。第一个是默认链
CHAINS=bsc
# 可选：自定义 RPC（默认使用内置免费 RPC）
# 可选：自定义 RPC，单链用 RPC_URL_BSC / RPC_URL_BASE / RPC_URL_ETH / RPC_URL_RH
RPC_URL=
# 买入档位（原生币数量，逗号分隔）
# 可选：覆盖买入档位，例如 BUY_AMOUNTS_BSC=0.001,0.002,0.003（不填则用内置默认值）
# BUY_AMOUNTS_BSC=
# 默认滑点百分比（meme 币波动大，默认 10%，上限 20%）
DEFAULT_SLIPPAGE_PCT=10
